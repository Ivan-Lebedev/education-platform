# Файл с настройками для библиотеки codespell.


[codespell]
# Игнорирование следующих файлов, форматов и директорий.
skip =
    venv/,
    vscode/,
    logs/,
    .dockerignore,
    .gitignore,
    poetry.lock,
    pyproject.toml,
    bootstrap*,
    *.json,
    *.sql,
    *.csv,
    *.pyc,

[options]


# Игнорирование следующих слов.
ignore-words-list = ""

# Кодировка файлов.
encoding = utf-8

# Детальность отчетности после выполнении проверки.
# - 0 или не указан - весь процесс проверки, имена всех проверяемых файлов и найденные ошибки;
# - 1 - только имена проверяемых файлов и найденные ошибки. Скрывает сводную статистику;
# - 2 - только найденные ошибки. Полностью скрывает весь процесс проверки.
# - 3 - только ненулевой код ошибки при обнаружении проблем.
quiet-level = 2

# Автоматически применяет все исправления (без уточнения по каждому случаю).
interactive = True
